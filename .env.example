# Kerdostat Full-Stack Production & Development Environment Variables

# Server Environment & Runtime Mode ('production' or 'development')
ENVIRONMENT=production
WORKERS=4
LOG_LEVEL=info

# Security & CORS
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_SECRET_KEY_MIN_32_BYTES
ACCESS_TOKEN_EXPIRE_MINUTES=480
ALLOWED_ORIGINS=http://localhost,http://localhost:80,https://yourdomain.com

# Database Connection
# SQLite (default fallback): sqlite:///./kerdostat.db
# PostgreSQL (Production recommended): postgresql://kerdostat_user:strong_password@postgres:5432/kerdostat
DATABASE_URL=sqlite:///./kerdostat.db

# Redis Message Broker & Pub/Sub
REDIS_URL=redis://redis:6379/0

# Broker API Integration — Alpaca (US Markets)
MOCK_ALPACA=true
ALPACA_API_KEY=your_alpaca_api_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Broker API Integration — Fyers (Indian Markets)
MOCK_FYERS=true
FYERS_APP_ID=your_fyers_app_id_here
FYERS_ACCESS_TOKEN=your_fyers_access_token_here
