# Environment Configuration for Kerdostat Backend

# App Settings
APP_NAME=Kerdostat
APP_VERSION=1.0.0
APP_ENV=development
LOG_LEVEL=INFO

# Database Configuration (PostgreSQL / SQLite fallback for local dev)
DATABASE_URL=sqlite:///./kerdostat.db
# PostgreSQL Example: postgresql://user:password@localhost:5432/kerdostat

# Redis Configuration (For Caching & Pub/Sub)
REDIS_URL=redis://localhost:6379/0

# JWT Security
SECRET_KEY=your-super-secret-jwt-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Alpaca Paper Trading API Credentials
# Get free keys at: https://app.alpaca.markets/paper-trading/overview
ALPACA_API_KEY=your_paper_api_key_here
ALPACA_SECRET_KEY=your_paper_secret_key_here
ALPACA_BASE_URL=https://paper-api.alpaca.markets
